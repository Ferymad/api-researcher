# Required API Keys
OPENAI_API_KEY=  # Required for all agents - obtain from https://platform.openai.com/api-keys
EXA_API_KEY=  # Required for semantic search - obtain from https://exa.ai/ (~$20/month)
BRAVE_API_KEY=  # Required for web search - obtain from https://brave.com/search/api/ (2K free searches/month)

# Optional API Keys
CONTEXT7_API_KEY=  # Optional for enhanced library docs - obtain from https://context7.com/ (free tier available)
JINA_API_KEY=  # Optional for increased rate limits - obtain from https://jina.ai/ (10M free tokens/month)
